# App
APP_NAME="AI Workforce SaaS"
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# AI providers (optional — the simulation provider is used when unset)
AI_PROVIDER=simulation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Production drop-ins (unused by the in-memory store)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_workforce
REDIS_URL=redis://localhost:6379/0
